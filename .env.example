# OpenAI API key - used for embeddings and chat completions
OPENAI_API_KEY=

# Pinecone API key - used for vector database storage and retrieval
PINECONE_API_KEY=

# Upstash Redis - used to persist the ingested source registry
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth.js - session encryption secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=

# GitHub OAuth App - used for sign-in
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared secret checked against Vercel Cron's Authorization header, so the
# inactive-user cleanup endpoint can't be triggered by anyone else
# (generate with `openssl rand -hex 32`)
CRON_SECRET=
